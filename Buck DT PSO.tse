        component "core/C function" Buffer {
            arb_defs = "/*Begin code section*/
#define BUFFER_SIZE 10000
#define DOWNSAMPLE_RATIO 10

// Matriz de dados (Buffers Globais). 
double Vout_real_buf[BUFFER_SIZE];
double IL_real_buf[BUFFER_SIZE];
double Vout_twin_buf[BUFFER_SIZE];
double IL_twin_buf[BUFFER_SIZE];

// Variáveis de estado mantidas entre os passos de simulação
int buf_idx;
int ds_counter;
int is_sampling;
int buffer_ready_flag;
double last_trigger;
/*End code section*/"
            execution_rate = "1e-06"
            init_fnc = "/*Begin code section*/
buf_idx = 0;
ds_counter = 0;
is_sampling = 0;
buffer_ready_flag = 0;
last_trigger = 0.0;
/*End code section*/"
            input_terminals = "inherit in_vsw;real in_i_real;real in_v_real;real trigger;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True"
            input_terminals_show_labels = "True;True;True;True"
            output_fnc = "/*Begin code section*/
// Saída única do bloco: 0.0 (coletando) ou 1.0 (matriz pronta para o PSO)
buffer_flag = (double)buffer_ready_flag;

// Converte o endereço do vetor para double e joga na saída do bloco
out_ptr_vout = (double)(unsigned long long)Vout_real_buf;
out_ptr_il   = (double)(unsigned long long)IL_real_buf;
/*End code section*/"
            output_terminals = "real buffer_flag;inherit out_ptr_vout;inherit out_ptr_il;"
            output_terminals_dimensions = "inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True"
            output_terminals_show_labels = "True;True;True"
            update_fnc = "/*Begin code section*/
// Lendo as entradas do esquemático
double Vout_r  = in_v_real;
double IL_r    = in_i_real;
double trig    = trigger;
double pwm_sig = in_vsw-50;

// Variáveis estáticas de controle de estado do gatilho
static int armado = 0;
static int last_pwm = 0;
static int last_trigger = 0;

// 1. Transforma o buffer_ready_flag em um impulso de um único ciclo de clock
if (buffer_ready_flag == 1) {
    buffer_ready_flag = 0;
}

// O \"trigger\" serve apenas para \"armar\" a captura
if (trig > 0.5 && last_trigger <= 0.5) {
    armado = 1; 
}
last_trigger = trig;

// Converte o sinal analógico/digital do PWM em nível lógico 0 ou 1
int pwm_atual = (pwm_sig > 0) ? 1 : 0;

// Se estiver armado pelo botão, o disparo real (buf_idx = 0) só acontece 
// no microssegundo exato em que o PWM vira nível alto (início do ciclo)
if (armado == 1 && pwm_atual == 1 && last_pwm == 0) {
    buf_idx = 0;
    ds_counter = 0;
    is_sampling = 1;
    armado = 0;
}
last_pwm = pwm_atual;

// Rotina de amostragem (Downsampling)
if (is_sampling) {
    ds_counter++;
    
    if (ds_counter >= DOWNSAMPLE_RATIO) {
        ds_counter = 0; // Reseta contador
        
        // Escreve os dados nas matrizes de memória compartilhada para o PSO
        Vout_real_buf[buf_idx] = Vout_r;
        IL_real_buf[buf_idx]   = IL_r;
        
        buf_idx++;
        
        // Se a matriz chegou ao limite, encerra a coleta e dispara o pulso para o PSO
        if (buf_idx >= BUFFER_SIZE) {
            is_sampling = 0;
            buffer_ready_flag = 1; // Pulso enviado para o Bloco do PSO iniciar a otimização
        }
    }
}
/*End code section*/"
        }
