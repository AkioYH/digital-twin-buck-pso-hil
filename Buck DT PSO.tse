        component "core/Scope" Scope1 {
            selected_signals = "[\'RL_real\', \'RSE_real\', \'Vo_real\', \'Vo_twin\', \'IL_real\', \'IL_twin\', \'RL_twin\', \'RSE_twin\', \'f_obj\', \'Iter\']"
            signals_data = "{\"plot_settings\": {\"layout\": \"Vertical\", \"background_color\": \"white\", \"legend_visible\": true, \"signals_tooltips_enabled\": true}, \"signals\": {\"RL_real\": {\"viewports\": [1], \"type\": \"analog\", \"color\": {\"1\": \"#0000ff\"}, \"display\": {\"1\": \"dashed\"}, \"is_manual\": {\"1\": true}}, \"RSE_real\": {\"viewports\": [2], \"type\": \"analog\", \"color\": {\"2\": \"#FF0000\"}, \"display\": {\"2\": \"solid\"}, \"is_manual\": {\"2\": false}}, \"Vo_real\": {\"viewports\": [3], \"type\": \"analog\", \"color\": {\"3\": \"#FF0000\"}, \"display\": {\"3\": \"solid\"}, \"is_manual\": {\"3\": false}}, \"Vo_twin\": {\"viewports\": [3], \"type\": \"analog\", \"color\": {\"3\": \"#00CC00\"}, \"display\": {\"3\": \"solid\"}, \"is_manual\": {\"3\": false}}, \"IL_real\": {\"viewports\": [4], \"type\": \"analog\", \"color\": {\"4\": \"#FF0000\"}, \"display\": {\"4\": \"solid\"}, \"is_manual\": {\"4\": false}}, \"IL_twin\": {\"viewports\": [4], \"type\": \"analog\", \"color\": {\"4\": \"#00CC00\"}, \"display\": {\"4\": \"solid\"}, \"is_manual\": {\"4\": false}}, \"RL_twin\": {\"viewports\": [1], \"type\": \"analog\", \"color\": {\"1\": \"#00CC00\"}, \"display\": {\"1\": \"solid\"}, \"is_manual\": {\"1\": false}}, \"RSE_twin\": {\"viewports\": [2], \"type\": \"analog\", \"color\": {\"2\": \"#00CC00\"}, \"display\": {\"2\": \"solid\"}, \"is_manual\": {\"2\": false}}, \"f_obj\": {\"viewports\": [5], \"type\": \"analog\", \"color\": {\"5\": \"#FF0000\"}, \"display\": {\"5\": \"solid\"}, \"is_manual\": {\"5\": false}}, \"Iter\": {\"viewports\": [6], \"type\": \"analog\", \"color\": {\"6\": \"#FF0000\"}, \"display\": {\"6\": \"solid\"}, \"is_manual\": {\"6\": false}}}, \"viewports\": {\"1\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"2\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"3\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"4\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"5\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}, \"6\": {\"log_scale_x\": false, \"log_scale_y\": false, \"y_axis_db\": false}}}"
            user_range_data = "{\"1\": {\"user_x_range_mode\": \"Manual\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0.25, 0.35], \"user_y_range\": [0.0, 1.0]}, \"2\": {\"user_x_range_mode\": \"Manual\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0.25, 0.35], \"user_y_range\": [0.0, 1.0]}, \"3\": {\"user_x_range_mode\": \"Manual\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0.25, 0.35], \"user_y_range\": [0.0, 1.0]}, \"4\": {\"user_x_range_mode\": \"Manual\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0.25, 0.35], \"user_y_range\": [0.0, 1.0]}, \"5\": {\"user_x_range_mode\": \"Manual\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0.25, 0.35], \"user_y_range\": [0.0, 1.0]}, \"6\": {\"user_x_range_mode\": \"Manual\", \"user_y_range_mode\": \"Zoom to fit\", \"user_x_range\": [0.25, 0.35], \"user_y_range\": [0.0, 1.0]}}"
        }
        [
            position = 8752, 8288
        ]

        component "core/Variable Resistor" RSE1 {
            inductance = "1e-15"
        }
        [
            position = 8508, 8220
            rotation = left
            size = 64, 48
        ]

        component "core/C function" PSO {
            arb_defs = "/*Begin code section*/
#define BUFFER_SIZE 10000
#define NUM_PARTICLES 150     
#define ITERS_PER_STEP 1     
#define MAX_ITER 300         

#define W 0.55
#define C1 0.4
#define C2 0.2
#define V_MAX 0.15

/* --- VARIÁVEIS GLOBAIS DE SAÍDA --- */
double RL_est = 0.005;
double RSE_est = 0.05;
double V_d_est = 0.01;
double R_on_est = 0.0001;

int pso_done_flag = 0;
double gbest_error = 1e30;

/* --- CONTROLE DO PSO --- */
int last_buffer_flag = 0;      
int pso_state = 0;              
int current_iter = 0;
/*End code section*/"
            execution_rate = "1e-06"
            init_fnc = "/*Begin code section*/
RL_est = 0.005;
RSE_est = 0.05;
V_d_est = 0.01;
R_on_est = 0.0001;
pso_done_flag = 0;
gbest_error = 1e30;
pso_state = 0;
current_iter = 0;
last_buffer_flag = 0;
/*End code section*/"
            input_terminals = "real buffer_flag;real ptr_vout;real ptr_il;real in_duty;inherit seed;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True"
            output_fnc = "/*Begin code section*/
out_RL = RL_est;
out_RSE = RSE_est;
pso_flag = (double)pso_done_flag;

out_error  = gbest_error;       
out_iter   = (double)current_iter; 
out_status = (double)pso_state;
/*End code section*/"
            output_terminals = "inherit out_error;inherit out_iter;inherit out_status;real out_RSE;real out_RL;real pso_flag;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True;True"
            output_terminals_show_labels = "True;True;False;True;True;True"
            update_fnc = "/*Begin code section*/
// Recupera os ponteiros enviados pelo Bloco de Captura
double *Vout_real_buf = (double *)(unsigned long long)ptr_vout;
double *IL_real_buf   = (double *)(unsigned long long)ptr_il;

int buffer_ready = (int)buffer_flag;
double D_real = in_duty;

// Constantes físicas fixas do circuito Buck
static const double p_L  = 1.0e-3;   // 1 mH
static const double p_C  = 235.0e-6; // 235 uF
static const double p_Ro = 16.0;     // 16 Ohms
static const double Vin  = 100.0;

static unsigned long pso_seed = 123456789UL;

// Estruturas locais reduzidas para 4 Dimensões (RL, RSE, V_d, R_on)
typedef struct { double RL, RSE, V_d, R_on; } Params4D;

typedef struct {
    Params4D norm_pos;
    Params4D vel;
    Params4D norm_best_pos;
    double best_error;
} Particle;

static Particle swarm[NUM_PARTICLES];
static Params4D gbest_norm;

// Limites de busca para as 4 variáveis ativas
const double min_RL  = 0.001,  max_RL  = 0.015;
const double min_RSE = 0.05,   max_RSE = 0.50;
const double min_V_d = 0.05, max_V_d = 0.5;
const double min_R_on = 0.0001, max_R_on = 0.05;

// Variáveis para escala dinâmica (s_vo, s_il) calculadas a partir do buffer
static double s_vo = 0.001;
static double s_il = 0.001;

// =========================================================================
// DETECÇÃO DE BORDA DE SUBIDA: RESET E INICIALIZAÇÃO
// =========================================================================
if (buffer_ready == 1 && last_buffer_flag == 0) {
    pso_state = 1;
    current_iter = 0;
    pso_done_flag = 0;
    gbest_error = 1e30;
    
    pso_seed = (unsigned long)seed;

    // Calcula escalas s_vo e s_il dinamicamente do buffer real
    s_vo = 0.001;
    s_il = 0.001;
    for (int k = 0; k < BUFFER_SIZE; k++) {
        if (fabs(Vout_real_buf[k]) > s_vo) s_vo = fabs(Vout_real_buf[k]);
        if (fabs(IL_real_buf[k]) > s_il) s_il = fabs(IL_real_buf[k]);
    }

    for (int i = 0; i < NUM_PARTICLES; i++) {
        double *n_pos = (double*)&swarm[i].norm_pos;
        double *v_pos = (double*)&swarm[i].vel;
        
        for (int j = 0; j < 4; j++) {
            pso_seed = pso_seed * 1664525UL + 1013904223UL;
            n_pos[j] = 0.2 + ((double)pso_seed / 4294967295.0) * 0.6;
            v_pos[j] = 0.0;
        }
        
        swarm[i].norm_best_pos = swarm[i].norm_pos;
        swarm[i].best_error = 1e30;
    }
}
last_buffer_flag = buffer_ready;

// =========================================================================
// ESTADO 1: LAÇO DE OTIMIZAÇÃO EM TEMPO REAL
// =========================================================================
if (pso_state == 1) {
    for (int step_it = 0; step_it < ITERS_PER_STEP; step_it++) {
        if (current_iter >= MAX_ITER) {
            pso_state = 0;
            pso_done_flag = 1;
            break;
        }

        // Hiperparâmetros de movimento do PSO
        double w  = W;
        double c1 = C1, c2 = C2;
        const double v_max = V_MAX;

        // Cálculo do Duty cycle efetivo considerando tempo morto
        double fs = 10000.0;       // Frequência de chaveamento em Hz
        double td = 1e-6*0;           // Tempo morto em segundos (ajustável se necessário)
        double D_effective = D_real - (td * fs);

        for (int i = 0; i < NUM_PARTICLES; i++) {
            double *p  = (double*)&swarm[i].norm_pos;
            double *v  = (double*)&swarm[i].vel;
            double *bp = (double*)&swarm[i].norm_best_pos;
            double *gp = (double*)&gbest_norm;

            // 1. Atualização Cinemática das 4 Variáveis
            for (int j = 0; j < 4; j++) {
                pso_seed = pso_seed * 1664525UL + 1013904223UL;
                double r1 = (double)pso_seed / 4294967295.0;
                pso_seed = pso_seed * 1664525UL + 1013904223UL;
                double r2 = (double)pso_seed / 4294967295.0;

                v[j] = (w * v[j]) + (c1 * r1 * (bp[j] - p[j])) + (c2 * r2 * (gp[j] - p[j]));
                
                if (v[j] > v_max) v[j] = v_max;
                if (v[j] < -v_max) v[j] = -v_max;
                
                p[j] += v[j];
                
                if (p[j] < 0.0) { p[j] = 0.001; v[j] *= -0.5; }
                if (p[j] > 1.0) { p[j] = 0.999; v[j] *= -0.5; }
            }

            // 2. Desnormalização dos Parâmetros Ativos da Partícula
            double p_RL   = min_RL   + p[0] * (max_RL   - min_RL);
            double p_RSE  = min_RSE  + p[1] * (max_RSE  - min_RSE);
            double p_V_d  = min_V_d  + p[2] * (max_V_d  - min_V_d);
            double p_R_on = min_R_on + p[3] * (max_R_on - min_R_on);

            // 3. Simulação Interna e Função Custo Completa
            double dt = 10e-6; 
            double vC_sim = Vout_real_buf[0] * (1.0 + p_RSE / p_Ro) - IL_real_buf[0] * p_RSE;
            double iL_sim = IL_real_buf[0];

            double total_error_rms = 0.0;
            int evaluated_points = 0;
            int start_point = (int)(BUFFER_SIZE * 0.10);

            double vo_sim_max = -1e30, vo_sim_min =  1e30;
            double vo_exp_max = -1e30, vo_exp_min =  1e30;

            for (int k = 0; k < BUFFER_SIZE - 1; k++) {
                int samples_per_cycle = (int)(1.0 / (fs * dt));
                int sample_in_cycle = k % samples_per_cycle;
                int pwm = (sample_in_cycle < (int)(D_real * (double)samples_per_cycle)) ? 1 : 0;

                double vo_sim = (vC_sim + p_RSE * iL_sim) / (1.0 + p_RSE / p_Ro);

                if (k >= start_point) {
                    double err_i = (IL_real_buf[k] - iL_sim) / s_il; 
                    double err_v = (Vout_real_buf[k] - vo_sim) / s_vo; 

                    total_error_rms += (12.0 * err_i * err_i) + (3.0 * err_v * err_v);
                    evaluated_points++;

                    if (vo_sim > vo_sim_max) vo_sim_max = vo_sim;
                    if (vo_sim < vo_sim_min) vo_sim_min = vo_sim;
                    if (Vout_real_buf[k] > vo_exp_max) vo_exp_max = Vout_real_buf[k];
                    if (Vout_real_buf[k] < vo_exp_min) vo_exp_min = Vout_real_buf[k];
                }

                // Passo 1 - Euler Modificado (Predictor-Corrector)
                double v_switch1 = (pwm == 1) ? (Vin - iL_sim * p_R_on) : (-p_V_d);
                double diL_dt1 = (v_switch1 - vo_sim - iL_sim * p_RL) / p_L;
                double dvC_dt1 = (iL_sim - (vo_sim / p_Ro)) / p_C;

                double iL_sim_pred = iL_sim + (diL_dt1 * dt);
                double vC_sim_pred = vC_sim + (dvC_dt1 * dt);
                double vo_sim_pred = (vC_sim_pred + p_RSE * iL_sim_pred) / (1.0 + p_RSE / p_Ro);

                // Passo 2 - Euler Modificado
                double v_switch2 = (pwm == 1) ? (Vin - iL_sim_pred * p_R_on) : (-p_V_d);
                double diL_dt2 = (v_switch2 - vo_sim_pred - iL_sim_pred * p_RL) / p_L;
                double dvC_dt2 = (iL_sim_pred - (vo_sim_pred / p_Ro)) / p_C;

                iL_sim += (diL_dt1 + diL_dt2) * 0.5 * dt;
                vC_sim += (dvC_dt1 + dvC_dt2) * 0.5 * dt;

                if (isnan(total_error_rms)) {
                    total_error_rms = 1e20;
                    break;
                }
            }

            // Cálculo do Erro de Pico a Pico (Ripple)
            double pp_sim = vo_sim_max - vo_sim_min;
            double pp_exp = vo_exp_max - vo_exp_min;
            double err_pp = 0.0;
            if (pp_exp > 0.001 && evaluated_points > 0) {
                err_pp = (pp_exp - pp_sim) / pp_exp;
                err_pp = err_pp * err_pp;
            }

            // Balanço DC Teórico
            double Vo_dc_exp = Vout_real_buf[BUFFER_SIZE - 1];
            double Vo_dc_theory = D_effective * Vin;
            double err_dc = (Vo_dc_exp - Vo_dc_theory) / s_vo;
            double penalty_dc = 3.0 * err_dc * err_dc;

            // Custo Total Consolidado
            double error_rms = total_error_rms / (evaluated_points + 1);
            double current_err = error_rms + err_pp + penalty_dc;

            if (isnan(current_err) || isinf(current_err)) {
                current_err = 1e30; // Atribui um custo altíssimo para penalizar a partícula instável
            }

            // 4. Atualização de pBest e gBest
            if (current_err < swarm[i].best_error) {
                swarm[i].best_error = current_err;
                swarm[i].norm_best_pos = swarm[i].norm_pos;
            }

            if (current_err < gbest_error) {
                gbest_error = current_err;
                gbest_norm = swarm[i].norm_pos;

                // ATUALIZAÇÃO EM TEMPO REAL: 
                // Recalcula as variáveis de saída imediatamente a cada melhora global
                RL_est   = min_RL   + gbest_norm.RL   * (max_RL   - min_RL);
                RSE_est  = min_RSE  + gbest_norm.RSE  * (max_RSE  - min_RSE);
                V_d_est  = min_V_d  + gbest_norm.V_d  * (max_V_d  - min_V_d);
                R_on_est = min_R_on + gbest_norm.R_on * (max_R_on - min_R_on);
            }
        }
        
        current_iter++;
    }
}
/*End code section*/"
